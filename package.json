{
    "name": "pulsar-monorepo",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev:core": "bun --filter @nightx.co/pulsar dev",
        "build:core": "bun --filter @nightx.co/pulsar build",
        "patch:core": "cd packages/core && npm version patch",
        "release:core": "cd packages/core/builds && npm publish --access public",
        "dev:client": "bun --filter @nightx.co/pulsar-client dev",
        "build:client": "bun --filter @nightx.co/pulsar-client build",
        "patch:client": "cd packages/client && npm version patch",
        "release:client": "cd packages/client/builds && npm publish --access public",
        "web": "bun --filter site dev",
        "build:web": "bun --filter site build",
        "build": "bun --filter '*' build"
    },
    "dependencies": {
        "dotenv": "^18.0.9",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "^0.45.4"
    }
}