{
    "name": "@nightx.co/pulsar-client",
    "version": "1.0.6",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "index.ts",
    "types": "./dist/index.d.ts",
    "private": false,
    "exports": {
        "./class": {
            "types": "./dist/class/index.d.ts",
            "import": "./dist/class/index.js",
            "default": "./dist/class/index.js"
        },
        "./storage": {
            "types": "./dist/storage/index.d.ts",
            "import": "./dist/storage/index.js",
            "default": "./dist/storage/index.js"
        }
    },
    "typesVersions": {
        "*": {
            "storage": [
                "./dist/storage/index.d.ts"
            ],
            "consumer": [
                "./dist/class/index.d.ts"
            ]
        }
    },
    "files": [
        "dist",
		"README.md"
    ],
    "scripts": {
        "build": "bun run build.ts;",
        "dev": "bun run src/run/index.ts"
    },
    "devDependencies": {
        "@types/bun": "latest"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@msgpack/msgpack": "^3.1.3",
        "crossws": "^0.4.16",
        "eventemitter3": "^5.0.4",
        "serverless-http": "^4.0.0",
        "srvx": "^1.0.7",
        "postgres": "^3.4.9",
        "@upstash/redis": "^1.39.0",
        "ioredis": "^6.0.0"
    }
}
