{
	"name": "@nightx.co/pulsar",
	"version": "1.0.23",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "index.ts",
	"types": "./dist/index.d.ts",
	"private": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./helpers": {
			"types": "./dist/helpers/index.d.ts",
			"import": "./dist/helpers/index.js",
			"default": "./dist/helpers/index.js"
		},
		"./integrations": {
			"types": "./dist/integrations/index.d.ts",
			"import": "./dist/integrations/index.js",
			"default": "./dist/integrations/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js",
			"default": "./dist/server/index.js"
		},
		"./storage": {
			"types": "./dist/storage/index.d.ts",
			"import": "./dist/storage/index.js",
			"default": "./dist/storage/index.js"
		}
	},
	"typesVersions": {
		"*": {
			"storage": [
				"./dist/storage/index.d.ts"
			],
			"server": [
				"./dist/server/index.d.ts"
			],
			"integrations": [
				"./dist/integrations/index.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "bun run build.ts;",
		"dev": "bun --preload ./lua-plugin.ts src/run/index.ts"
	},
	"devDependencies": {
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"@upstash/redis": "^1.39.0",
		"crossws": "^0.4.16",
		"eventemitter3": "^5.0.4",
		"ioredis": "^6.0.0",
		"js-sha256": "^1.0.0",
		"postgres": "^3.4.9",
		"srvx": "^1.0.7"
	}
}
